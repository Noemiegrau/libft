/*   Created: 2025/11/11 18:42:56 by nograu            #+#    #+#             */
/*   Updated: 2025/11/11 18:43:06 by nograu           ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

char	*ft_strnstr(const char *s1, const char *s2, size_t size)
{
	size_t	i;
	size_t	j;

	i = 0;
	if (*s2 == '\0')
		return ((char *)s1);
	while (s1[i] && i < size)
	{
		j = 0;
		while (s1[i + j] && s1[i + j] == s2[j] && (i + j) < size)
			j++;
		if (s2[j] == '\0')
			return ((char *)&s1[i]);
		i++;
	}
	return (NULL);
}
