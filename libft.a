#include "libft.h"

void	*ft_calloc(size_t nmemb, size_t size)
{
	void	*ptr;
	size_t	calcul;

	if (nmemb != 0 && size != 0 && nmemb > SIZE_MAX / size)
		return (NULL);
	calcul = nmemb * size;
	ptr = malloc(calcul);
	if (!ptr)
		return (NULL);
	ft_bzero(ptr, calcul);
	return (ptr);
}

