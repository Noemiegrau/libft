/*   Created: 2025/11/11 15:49:00 by nograu            #+#    #+#             */
/*   Updated: 2025/11/16 15:14:10 by nograu           ###   ########.fr       */
/*                                                                            */
/* ************************************************************************** */

#include "libft.h"

char	*ft_substr(char const *s, unsigned int start, size_t len)
{
	char			*sub;
	unsigned int	i;
	
	if (!s || start > ft_strlen(s))
		return (NULL);
	sub = malloc(sizeof(char) * len + 1);
	if (!sub)
		return (NULL);
	i = 0;
	while (s[i] && i < len)
		sub[i++] = s[start++];
	sub[i] = '\0';
	return (sub);
}

